{
  "name": "pos-crud-mfa-demo",
  "version": "1.0.0",
  "description": "Mini aplicação CRUD com autenticação e MFA OTP para estudo de hardening de segurança.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:health": "curl -fsS http://127.0.0.1:8088/api/health"
  },
  "keywords": [
    "crud",
    "mfa",
    "otp",
    "react",
    "express",
    "sqlite",
    "security"
  ],
  "author": "Luan Luz",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.541.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "speakeasy": "^2.0.0",
    "vite": "^7.1.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/speakeasy": "^2.0.10",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4"
  }
}
