PORT=3001
# Placeholder intencionalmente não funcional: gere um valor aleatório >= 32 chars.
# Exemplo de geração: openssl rand -base64 48
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_BEFORE_RUNNING
# Placeholders intencionalmente não funcionais; troque antes de iniciar com banco vazio.
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=GENERATE_A_STRONG_ADMIN_PASSWORD
# Opcional: conta limitada para o corretor automatizado. Não exige MFA e não é admin.
EVALUATOR_EMAIL=EVALUATOR_EMAIL_FOR_AUTOMATED_REVIEW
EVALUATOR_PASSWORD=GENERATE_A_STRONG_EVALUATOR_PASSWORD
# Local HTTP: false. Produção HTTPS/reverse proxy: true.
COOKIE_SECURE=false
